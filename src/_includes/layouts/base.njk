<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
</head>
<body>
  <main id="main">
    {{ content | safe }}
  </main>
</body>
</html>
