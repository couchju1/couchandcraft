{#- Expects: faqs = [{ q, a }] (a may contain simple HTML, null hides the item). Optional: faqHeading, faqId -#}
{%- set faqs = faqs | faqReady -%}
{%- if faqs.length %}
<section class="faq" aria-labelledby="{{ faqId or 'faq' }}-heading">
  <h2 id="{{ faqId or 'faq' }}-heading">{{ faqHeading or "Questions people ask" }}</h2>
  <div class="faq__list">
    {%- for item in faqs %}
    <details class="faq__item">
      <summary class="faq__question">{{ item.q }}</summary>
      <div class="faq__answer flow">{{ item.a | safe }}</div>
    </details>
    {%- endfor %}
  </div>
</section>
<script type="application/ld+json">{{ faqs | faqSchema | jsonLd | safe }}</script>
{%- endif %}
