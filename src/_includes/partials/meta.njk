{%- set canonical = page.url | absoluteUrl(site.business.url) -%}
<title>{{ title }}</title>
{% if description %}<meta name="description" content="{{ description }}">
{% endif %}{% if noindex %}<meta name="robots" content="noindex">
{% endif %}<link rel="canonical" href="{{ canonical }}">
<meta property="og:site_name" content="{{ site.business.name }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_US">
<meta property="og:title" content="{{ ogTitle or title }}">
{% if description %}<meta property="og:description" content="{{ description }}">
{% endif %}<meta property="og:url" content="{{ canonical }}">
{% if ogImage %}<meta property="og:image" content="{{ ogImage | absoluteUrl(site.business.url) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{% endif %}
