{#- Expects: entry (from site.work) -#}
{%- set shot = "/assets/img/work/source/" + entry.slug + "-desktop.png" -%}
{%- set shotSrc = "work/source/" + entry.slug + "-desktop.png" -%}
<article class="work-card">
  <div class="work-card__media">
    {%- if shotSrc | hasImage %}
    <img src="{{ shot }}" alt="{{ entry.client }} website on desktop" sizes="(min-width: 1024px) 36rem, (min-width: 768px) 50vw, 100vw">
    {%- else %}
    <div class="work-card__placeholder"><p>[NEEDS: {{ entry.client }} screenshot]</p></div>
    {%- endif %}
  </div>
  <div class="work-card__body">
    {% if entry.inHouse %}<p class="eyebrow">Built and run by me</p>{% endif %}
    <h{{ cardLevel or 3 }} class="work-card__title"><a href="/work/{{ entry.slug }}/">{{ entry.client }}</a></h{{ cardLevel or 3 }}>
    <p class="work-card__meta">{{ entry.industry }} · {{ entry.location }}</p>
    <ul class="work-card__links">
      <li><a class="text-link" href="/work/{{ entry.slug }}/">Read the story<span class="visually-hidden">: {{ entry.client }}</span></a></li>
      {%- if entry.liveUrl | isSet %}
      <li><a class="text-link" href="{{ entry.liveUrl }}" rel="noopener">Visit the site<span class="visually-hidden">: {{ entry.client }}</span></a></li>
      {%- endif %}
    </ul>
  </div>
</article>
